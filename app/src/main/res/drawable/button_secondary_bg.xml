<?xml version="1.0" encoding="utf-8"?>
<!-- Secondary button: dark surface with a subtle border -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="#1FFFFFFF">
    <item>
        <selector>
            <item android:state_pressed="true">
                <shape android:shape="rectangle"><solid android:color="@color/surface_pressed" /><corners android:radius="14dp" /><stroke android:width="1dp" android:color="@color/border" /></shape>
            </item>
            <item>
                <shape android:shape="rectangle"><solid android:color="@color/surface_2" /><corners android:radius="14dp" /><stroke android:width="1dp" android:color="@color/border" /></shape>
            </item>
        </selector>
    </item>
</ripple>
