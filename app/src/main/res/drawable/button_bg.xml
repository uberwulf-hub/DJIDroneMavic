<?xml version="1.0" encoding="utf-8"?>
<!-- Primary (accent) button -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="#33FFFFFF">
    <item>
        <selector>
            <item android:state_enabled="false">
                <shape android:shape="rectangle"><solid android:color="@color/surface_2" /><corners android:radius="14dp" /></shape>
            </item>
            <item android:state_pressed="true">
                <shape android:shape="rectangle"><solid android:color="@color/accent_pressed" /><corners android:radius="14dp" /></shape>
            </item>
            <item>
                <shape android:shape="rectangle"><solid android:color="@color/accent" /><corners android:radius="14dp" /></shape>
            </item>
        </selector>
    </item>
</ripple>
