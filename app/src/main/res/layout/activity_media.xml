<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_blue">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingLeft="16dp"
        android:paddingRight="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btn_back"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:background="@android:color/transparent"
                android:text="‹ Back"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="16sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Photos &amp; Videos"
                android:textColor="#FFFFFF"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/status"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginLeft="16dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="#B3FFFFFF"
                android:textSize="13sp" />

            <Button
                android:id="@+id/btn_select"
                style="@style/SecondaryButton"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:paddingLeft="14dp"
                android:paddingRight="14dp"
                android:text="Select"
                android:textSize="14sp" />

            <Button
                android:id="@+id/btn_select_new"
                style="@style/SecondaryButton"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:layout_marginLeft="8dp"
                android:paddingLeft="14dp"
                android:paddingRight="14dp"
                android:text="Select new"
                android:textSize="14sp" />

            <Button
                android:id="@+id/btn_download"
                style="@style/BigButton"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:layout_marginLeft="8dp"
                android:paddingLeft="16dp"
                android:paddingRight="16dp"
                android:text="Download"
                android:textSize="14sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/progress_row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingLeft="8dp"
            android:paddingBottom="6dp"
            android:visibility="gone">

            <ProgressBar
                android:id="@+id/progress"
                style="@android:style/Widget.ProgressBar.Horizontal"
                android:layout_width="0dp"
                android:layout_height="8dp"
                android:layout_weight="1"
                android:max="1000"
                android:progressTint="@color/medium_blue" />

            <TextView
                android:id="@+id/progress_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="12dp"
                android:textColor="#FFFFFF"
                android:textSize="13sp" />

            <Button
                android:id="@+id/btn_cancel"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:background="@android:color/transparent"
                android:text="Cancel"
                android:textAllCaps="false"
                android:textColor="#FFB4A0"
                android:textSize="14sp" />
        </LinearLayout>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/grid"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:paddingBottom="16dp" />

            <TextView
                android:id="@+id/message"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:padding="32dp"
                android:textColor="#CCFFFFFF"
                android:textSize="16sp"
                android:visibility="gone" />
        </FrameLayout>
    </LinearLayout>

    <!-- Viewer -->
    <FrameLayout
        android:id="@+id/viewer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#F2000000"
        android:clickable="true"
        android:focusable="true"
        android:visibility="gone">

        <ImageView
            android:id="@+id/viewer_image"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginLeft="64dp"
            android:layout_marginTop="56dp"
            android:layout_marginRight="64dp"
            android:layout_marginBottom="72dp"
            android:scaleType="fitCenter" />

        <TextView
            android:id="@+id/viewer_play"
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:layout_gravity="center"
            android:background="@drawable/check_circle"
            android:gravity="center"
            android:text="▶"
            android:textColor="#FFFFFF"
            android:textSize="30sp"
            android:visibility="gone" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingLeft="16dp"
            android:paddingRight="16dp">

            <Button
                android:id="@+id/viewer_close"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:background="@android:color/transparent"
                android:text="✕ Close"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/viewer_info"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginLeft="12dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="#CCFFFFFF"
                android:textSize="14sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/viewer_prev"
            android:layout_width="56dp"
            android:layout_height="96dp"
            android:layout_gravity="start|center_vertical"
            android:gravity="center"
            android:text="‹"
            android:textColor="#FFFFFF"
            android:textSize="44sp" />

        <TextView
            android:id="@+id/viewer_next"
            android:layout_width="56dp"
            android:layout_height="96dp"
            android:layout_gravity="end|center_vertical"
            android:gravity="center"
            android:text="›"
            android:textColor="#FFFFFF"
            android:textSize="44sp" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|center_horizontal"
            android:layout_marginBottom="12dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/viewer_download"
                style="@style/BigButton"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:paddingLeft="20dp"
                android:paddingRight="20dp"
                android:text="Download"
                android:textSize="16sp" />

            <Button
                android:id="@+id/viewer_open"
                style="@style/SecondaryButton"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:layout_marginLeft="12dp"
                android:paddingLeft="20dp"
                android:paddingRight="20dp"
                android:text="Download &amp; open"
                android:textSize="16sp" />
        </LinearLayout>
    </FrameLayout>
</FrameLayout>
