<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_blue"
    android:baselineAligned="false"
    android:orientation="horizontal"
    android:padding="16dp">

    <!-- Left: status -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:gravity="center_vertical"
        android:orientation="vertical"
        android:paddingRight="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/app_name"
            android:textColor="#FFFFFF"
            android:textSize="34sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/status_sdk"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:textColor="@color/light_gray"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/status_product"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textColor="#FFFFFF"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/weather"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:textColor="#FFFFFF"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/last_flight"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:textColor="@color/light_gray"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/version"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:textColor="#80FFFFFF"
            android:textSize="12sp" />
    </LinearLayout>

    <!-- Right: actions -->
    <LinearLayout
        android:layout_width="260dp"
        android:layout_height="match_parent"
        android:gravity="center_vertical"
        android:orientation="vertical">

        <Button
            android:id="@+id/btn_fly"
            style="@style/BigButton"
            android:layout_height="64dp"
            android:text="@string/fly"
            android:textSize="24sp" />

        <TextView
            android:id="@+id/mode_hint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center"
            android:textColor="#99FFFFFF"
            android:textSize="12sp" />

        <Button
            android:id="@+id/btn_media"
            style="@style/SecondaryButton"
            android:layout_height="44dp"
            android:layout_marginTop="12dp"
            android:text="Photos &amp; Videos" />

        <Button
            android:id="@+id/btn_log"
            style="@style/SecondaryButton"
            android:layout_height="44dp"
            android:layout_marginTop="12dp"
            android:text="Flight Log" />

        <Button
            android:id="@+id/btn_batteries"
            style="@style/SecondaryButton"
            android:layout_height="44dp"
            android:layout_marginTop="12dp"
            android:text="Batteries" />

        <Button
            android:id="@+id/btn_settings"
            style="@style/SecondaryButton"
            android:layout_height="44dp"
            android:layout_marginTop="12dp"
            android:text="Safety &amp; Settings" />
    </LinearLayout>
</LinearLayout>
